# ==========================
# BDADN — Azure SQL de produccion (solo lectura de metadatos/SPs para esta fase)
# Copia este archivo a .env y llena los valores reales. NUNCA commitees .env.
# ==========================
BDADN_SERVER=adnprod.database.windows.net,1433
BDADN_DATABASE=BDADN
BDADN_USER=
BDADN_PASSWORD=

# ==========================
# API (se usa cuando arranque el backend en Fase 1+)
# ==========================
DATABASE_URL="file:./dev.db"
BDADN_ENCRYPT=true
BDADN_TRUST_SERVER_CERTIFICATE=false
BDADN_POOL_MIN=1
BDADN_POOL_MAX=10

AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_AUDIENCE=

DEV_BYPASS=true
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5174
