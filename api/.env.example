# BD plataforma (auth, permisos, auditoria) — SQLite en dev
DATABASE_URL="file:./dev.db"

# BDADN operativa (Azure SQL) — las credenciales reales viven en .env raiz por ahora
BDADN_SERVER=adnprod.database.windows.net,1433
BDADN_DATABASE=BDADN
BDADN_USER=
BDADN_PASSWORD=
BDADN_ENCRYPT=true
BDADN_TRUST_SERVER_CERTIFICATE=false
BDADN_POOL_MIN=1
BDADN_POOL_MAX=10
BDADN_CONNECT_TIMEOUT_MS=10000
BDADN_REQUEST_TIMEOUT_MS=30000

# Microsoft Entra ID (Fase 2+)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_AUDIENCE=

# Desarrollo
DEV_BYPASS=true
DEV_BYPASS_EMAIL=Operacionesadn@adnenergia.com
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5174
