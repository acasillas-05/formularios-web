# =====================================================================
# CONFIG DE PRODUCCION (Azure App Service / Container Apps)
# =====================================================================
# Plantilla: copia los valores reales a las "Application Settings" del
# App Service o al Key Vault referenciado. NUNCA commitees el .env real.

# ---------------------------------------------------------------------
# BD plataforma (Azure SQL — base separada de BDADN)
# ---------------------------------------------------------------------
# Connection string Prisma para SQL Server:
#   sqlserver://<host>:1433;database=<db>;user=<user>;password=<pwd>;encrypt=true
DATABASE_URL=

# ---------------------------------------------------------------------
# BDADN operativa (Azure SQL existente)
# ---------------------------------------------------------------------
BDADN_SERVER=adnprod.database.windows.net,1433
BDADN_DATABASE=BDADN
BDADN_USER=
BDADN_PASSWORD=
BDADN_ENCRYPT=true
BDADN_TRUST_SERVER_CERTIFICATE=false
BDADN_POOL_MIN=2
BDADN_POOL_MAX=20
BDADN_CONNECT_TIMEOUT_MS=10000
BDADN_REQUEST_TIMEOUT_MS=30000

# ---------------------------------------------------------------------
# Microsoft Entra ID (App Registration de la API)
# ---------------------------------------------------------------------
# tenantId de adnenergia.com
AZURE_AD_TENANT_ID=
# clientId del App Registration "Formularios ADN API"
AZURE_AD_CLIENT_ID=
# audience que el frontend pone en el token (api://<clientId>)
AZURE_AD_AUDIENCE=

# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
NODE_ENV=production

# DEV_BYPASS DEBE estar en false (o ausente) en produccion.
# El config.ts ya bloquea automaticamente si NODE_ENV=production,
# pero por defensa en profundidad, no lo definas aqui.
# DEV_BYPASS=false

# Azure App Service Linux pasa el puerto via variable PORT.
# Si lo defines manualmente, asegurate que coincida con el container o el host.
PORT=8080

# ---------------------------------------------------------------------
# CORS — dominio del frontend en produccion
# ---------------------------------------------------------------------
# Lista separada por comas. NO usar wildcard ni localhost en prod.
CORS_ORIGINS=https://formularios.adnenergia.com
