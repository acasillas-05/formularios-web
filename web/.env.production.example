# =====================================================================
# CONFIG DE PRODUCCION DEL FRONTEND (Vite -> Static Web Apps / nginx)
# =====================================================================
# Variables prefijadas con VITE_ se incluyen en el bundle al hacer
# `npm run build`. NO pongas secretos: todo lo del frontend es publico.

# Si el frontend y el API estan en el mismo dominio (recomendado), deja
# VITE_API_BASE_URL vacio para usar paths relativos /api/*.
# Si estan en dominios distintos (ej. SWA + App Service separados),
# pon aqui el dominio del API (e.g. https://api.formularios.adnenergia.com).
VITE_API_BASE_URL=

# Microsoft Entra ID (App Registration del frontend "SPA Formularios ADN")
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=
# El redirect URI debe coincidir EXACTAMENTE con el configurado en el
# App Registration (Single-page application redirect URI).
VITE_AZURE_REDIRECT_URI=https://formularios.adnenergia.com
